{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": ["openai", "ollama", "tabby", "opencode", "strata"],
  "model": "openai/gpt-6.1-sol",
  "small_model": "openai/gpt-6-luna",
  "plugins": [
    "./plugin/ollama-models.ts",
    "./plugin/compaction-fallback.ts",
    "./plugin/secret-file-guard.ts",
    "@dietrichgebert/ponytail"
  ],
  "permission": {
    "external_directory": "ask",
    "read": {
      "**/.env": "deny",
      "**/.env.*": "deny",
      ".env": "deny",
      ".env.*": "deny",
      "**/mise.toml": "deny",
      "mise.toml": "deny"
    },
    "edit": {
      "**/.env": "deny",
      "**/.env.*": "deny",
      ".env": "deny",
      ".env.*": "deny",
      "**/mise.toml": "deny",
      "mise.toml": "deny"
    }
  },
  "provider": {
    "openai": {
      "models": {
        "gpt-6.1-sol": {
          "limit": {
            "context": 400000,
            "input": 368000,
            "output": 32000
          }
        }
      }
    },
    "ollama": {
      "npm": "file:///home/bjorn/.config/opencode/provider/ollama-32k.mjs",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434"
      }
    },
    "strata": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Strata (local)",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1",
        "timeout": false
      },
      "models": {
        "strata-coder": {
          "name": "Strata Coder IQ1_M (128K)",
          "family": "qwen3.8",
          "reasoning": true,
          "tool_call": true,
          "interleaved": "reasoning_content",
          "limit": {
            "context": 131072,
            "output": 32768
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        }
      }
    },
    "tabby": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "TabbyAPI (local)",
      "options": {
        "baseURL": "http://127.0.0.1:5000/v1",
        "apiKey": "{file:~/.config/opencode/tabby-admin-key}",
        "timeout": false
      },
      "models": {
        "Qwen3.8-27B-exl3-2.50bpw": {
          "name": "Vision & Long Documents",
          "family": "qwen3.8",
          "reasoning": true,
          "tool_call": true,
          "interleaved": "reasoning_content",
          "limit": {
            "context": 122880,
            "output": 32768
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        },
        "Qwen3.8-27B-exl3-3.50bpw": {
          "name": "Coding & Reasoning - Balanced",
          "family": "qwen3.8",
          "reasoning": true,
          "tool_call": true,
          "interleaved": "reasoning_content",
          "limit": {
            "context": 65536,
            "output": 32768
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        },
        "Qwen3.8-27B-exl3-4.00bpw": {
          "name": "Coding & Reasoning - Best Quality",
          "family": "qwen3.8",
          "reasoning": true,
          "tool_call": true,
          "interleaved": "reasoning_content",
          "limit": {
            "context": 98304,
            "output": 32768
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        },
        "gemma-4-12B-it-exl3-4.00bpw_mul1": {
          "name": "Multilingual Generalist",
          "family": "gemma4",
          "reasoning": false,
          "tool_call": false,
          "limit": {
            "context": 131072,
            "output": 32768
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        },
        "Qwen3.5-9B-exl3-6.00bpw": {
          "name": "Fast Everyday Assistant",
          "family": "qwen3.5",
          "reasoning": false,
          "tool_call": true,
          "limit": {
            "context": 131072,
            "output": 32768
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        }
      }
    }
  },
  "agent": {
    "general": {
      "model": "openai/gpt-5.6-terra"
    },
    "explore": {
      "model": "openai/gpt-6-luna",
      "permission": {
        "external_directory": "ask"
      }
    },
    "compaction": {
      "model": "openai/gpt-6-luna"
    }
  },
  "mcp": {
    "tavily": {
      "type": "remote",
      "url": "https://mcp.tavily.com/mcp/",
      "headers": {
        "Authorization": "Bearer {env:TAVILY_API_KEY}"
      }
    }
  }
}
